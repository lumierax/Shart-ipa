const valid=x=>Number.isFinite(x);
export function sma(values,period=20){const out=Array(values.length).fill(null);let sum=0,count=0;for(let i=0;i<values.length;i++){const v=+values[i];if(valid(v)){sum+=v;count++}if(i>=period){const old=+values[i-period];if(valid(old)){sum-=old;count--}}if(i>=period-1&&count===period)out[i]=sum/period}return out}
export function ema(values,period=20){const out=Array(values.length).fill(null),k=2/(period+1);let seed=0,n=0,prev=null;for(let i=0;i<values.length;i++){const v=+values[i];if(!valid(v))continue;if(prev===null){seed+=v;n++;if(n===period){prev=seed/period;out[i]=prev}}else{prev=v*k+prev*(1-k);out[i]=prev}}return out}
export function rma(values,period=14){const out=Array(values.length).fill(null);let sum=0,prev=null;for(let i=0;i<values.length;i++){const v=+values[i];if(!valid(v))continue;if(prev===null){sum+=v;if(i===period-1){prev=sum/period;out[i]=prev}}else{prev=(prev*(period-1)+v)/period;out[i]=prev}}return out}
export function rsi(values,period=14){const gains=Array(values.length).fill(0),losses=Array(values.length).fill(0);for(let i=1;i<values.length;i++){const d=values[i]-values[i-1];gains[i]=Math.max(0,d);losses[i]=Math.max(0,-d)}const ag=rma(gains,period),al=rma(losses,period);return values.map((_,i)=>{if(ag[i]==null||al[i]==null)return null;if(al[i]===0)return 100;const rs=ag[i]/al[i];return 100-100/(1+rs)})}
export function atr(high,low,close,period=14){const tr=Array(close.length).fill(null);for(let i=0;i<close.length;i++){tr[i]=i===0?high[i]-low[i]:Math.max(high[i]-low[i],Math.abs(high[i]-close[i-1]),Math.abs(low[i]-close[i-1]))}return rma(tr,period)}
export function std(values,period=20){const out=Array(values.length).fill(null);for(let i=period-1;i<values.length;i++){let s=0,s2=0;for(let j=i-period+1;j<=i;j++){const v=values[j];s+=v;s2+=v*v}const m=s/period;out[i]=Math.sqrt(Math.max(0,s2/period-m*m))}return out}
export function bollinger(values,period=20,mult=2){const mid=sma(values,period),sd=std(values,period);return{mid,upper:mid.map((v,i)=>v==null?null:v+mult*sd[i]),lower:mid.map((v,i)=>v==null?null:v-mult*sd[i])}}
export function macd(values,fast=12,slow=26,signal=9){const f=ema(values,fast),s=ema(values,slow),line=values.map((_,i)=>f[i]==null||s[i]==null?null:f[i]-s[i]);const sig=ema(line.map(v=>v??NaN),signal);return{macd:line,signal:sig,hist:line.map((v,i)=>v==null||sig[i]==null?null:v-sig[i])}}
export function vwap(high,low,close,volume){const out=[];let pv=0,v=0;for(let i=0;i<close.length;i++){const tp=(high[i]+low[i]+close[i])/3;pv+=tp*volume[i];v+=volume[i];out.push(v?pv/v:null)}return out}
export function stochastic(high,low,close,kPeriod=14,dPeriod=3){const k=Array(close.length).fill(null);for(let i=kPeriod-1;i<close.length;i++){let hh=-Infinity,ll=Infinity;for(let j=i-kPeriod+1;j<=i;j++){hh=Math.max(hh,high[j]);ll=Math.min(ll,low[j])}k[i]=hh===ll?50:(close[i]-ll)/(hh-ll)*100}return{k,d:sma(k.map(x=>x??NaN),dPeriod)}}
export function highest(values,period){const o=Array(values.length).fill(null);for(let i=period-1;i<values.length;i++)o[i]=Math.max(...values.slice(i-period+1,i+1));return o}
export function lowest(values,period){const o=Array(values.length).fill(null);for(let i=period-1;i<values.length;i++)o[i]=Math.min(...values.slice(i-period+1,i+1));return o}
export function crossover(a,b,i){return i>0&&a[i]!=null&&b[i]!=null&&a[i-1]!=null&&b[i-1]!=null&&a[i]>b[i]&&a[i-1]<=b[i-1]}
export function crossunder(a,b,i){return i>0&&a[i]!=null&&b[i]!=null&&a[i-1]!=null&&b[i-1]!=null&&a[i]<b[i]&&a[i-1]>=b[i-1]}

export function wma(values,period=20){const out=Array(values.length).fill(null),den=period*(period+1)/2;for(let i=period-1;i<values.length;i++){let sum=0;for(let j=0;j<period;j++)sum+=values[i-period+1+j]*(j+1);out[i]=sum/den}return out}
export function dema(values,period=20){const e1=ema(values,period),e2=ema(e1.map(v=>v??NaN),period);return values.map((_,i)=>e1[i]==null||e2[i]==null?null:2*e1[i]-e2[i])}
export function tema(values,period=20){const e1=ema(values,period),e2=ema(e1.map(v=>v??NaN),period),e3=ema(e2.map(v=>v??NaN),period);return values.map((_,i)=>e1[i]==null||e2[i]==null||e3[i]==null?null:3*e1[i]-3*e2[i]+e3[i])}
export function roc(values,period=12){return values.map((v,i)=>i<period||!values[i-period]?null:(v/values[i-period]-1)*100)}
export function momentum(values,period=10){return values.map((v,i)=>i<period?null:v-values[i-period])}
export function obv(close,volume){const out=Array(close.length).fill(0);for(let i=1;i<close.length;i++)out[i]=out[i-1]+(close[i]>close[i-1]?volume[i]:close[i]<close[i-1]?-volume[i]:0);return out}
export function cci(high,low,close,period=20){const tp=close.map((c,i)=>(high[i]+low[i]+c)/3),ma=sma(tp,period),out=Array(close.length).fill(null);for(let i=period-1;i<close.length;i++){let dev=0;for(let j=i-period+1;j<=i;j++)dev+=Math.abs(tp[j]-ma[i]);dev/=period;out[i]=dev?(tp[i]-ma[i])/(.015*dev):0}return out}
export function williamsR(high,low,close,period=14){const out=Array(close.length).fill(null);for(let i=period-1;i<close.length;i++){let hh=-Infinity,ll=Infinity;for(let j=i-period+1;j<=i;j++){hh=Math.max(hh,high[j]);ll=Math.min(ll,low[j])}out[i]=hh===ll?-50:(hh-close[i])/(hh-ll)*-100}return out}
export function mfi(high,low,close,volume,period=14){const tp=close.map((c,i)=>(high[i]+low[i]+c)/3),out=Array(close.length).fill(null);for(let i=period;i<close.length;i++){let pos=0,neg=0;for(let j=i-period+1;j<=i;j++){const flow=tp[j]*volume[j];if(tp[j]>tp[j-1])pos+=flow;else if(tp[j]<tp[j-1])neg+=flow}out[i]=neg===0?100:100-100/(1+pos/neg)}return out}
export function cmo(values,period=14){const out=Array(values.length).fill(null);for(let i=period;i<values.length;i++){let up=0,down=0;for(let j=i-period+1;j<=i;j++){const d=values[j]-values[j-1];if(d>0)up+=d;else down-=d}out[i]=(up+down)?100*(up-down)/(up+down):0}return out}
export function donchian(high,low,period=20){const upper=highest(high,period),lower=lowest(low,period);return{upper,lower,mid:upper.map((v,i)=>v==null||lower[i]==null?null:(v+lower[i])/2)}}
export function keltner(high,low,close,period=20,mult=2){const mid=ema(close,period),a=atr(high,low,close,period);return{mid,upper:mid.map((v,i)=>v==null||a[i]==null?null:v+mult*a[i]),lower:mid.map((v,i)=>v==null||a[i]==null?null:v-mult*a[i])}}
export function adx(high,low,close,period=14){const plus=Array(close.length).fill(0),minus=Array(close.length).fill(0),tr=Array(close.length).fill(0);for(let i=1;i<close.length;i++){const up=high[i]-high[i-1],dn=low[i-1]-low[i];plus[i]=up>dn&&up>0?up:0;minus[i]=dn>up&&dn>0?dn:0;tr[i]=Math.max(high[i]-low[i],Math.abs(high[i]-close[i-1]),Math.abs(low[i]-close[i-1]))}const atrv=rma(tr,period),pdm=rma(plus,period),mdm=rma(minus,period),pdi=close.map((_,i)=>atrv[i]?100*pdm[i]/atrv[i]:null),mdi=close.map((_,i)=>atrv[i]?100*mdm[i]/atrv[i]:null),dx=close.map((_,i)=>pdi[i]!=null&&mdi[i]!=null&&(pdi[i]+mdi[i])?100*Math.abs(pdi[i]-mdi[i])/(pdi[i]+mdi[i]):null),adxv=rma(dx.map(v=>v??NaN),period);return{adx:adxv,plus:pdi,minus:mdi}}
export function supertrend(high,low,close,period=10,mult=3){const a=atr(high,low,close,period),out=Array(close.length).fill(null);let finalU=null,finalL=null,trend=1;for(let i=0;i<close.length;i++){if(a[i]==null)continue;const hl2=(high[i]+low[i])/2,bu=hl2+mult*a[i],bl=hl2-mult*a[i];finalU=i===0||finalU==null?bu:(bu<finalU||close[i-1]>finalU?bu:finalU);finalL=i===0||finalL==null?bl:(bl>finalL||close[i-1]<finalL?bl:finalL);if(trend===1&&close[i]<finalL)trend=-1;else if(trend===-1&&close[i]>finalU)trend=1;out[i]=trend===1?finalL:finalU}return out}
export function ichimoku(high,low,tenkan=9,kijun=26,senkou=52){const h9=highest(high,tenkan),l9=lowest(low,tenkan),h26=highest(high,kijun),l26=lowest(low,kijun),h52=highest(high,senkou),l52=lowest(low,senkou);return{tenkan:h9.map((v,i)=>v==null?null:(v+l9[i])/2),kijun:h26.map((v,i)=>v==null?null:(v+l26[i])/2),spanA:h26.map((_,i)=>h9[i]==null||h26[i]==null?null:((h9[i]+l9[i])/2+(h26[i]+l26[i])/2)/2),spanB:h52.map((v,i)=>v==null?null:(v+l52[i])/2)}}
export function psar(high,low,step=.02,max=.2){const n=high.length,out=Array(n).fill(null);if(n<2)return out;let bull=true,af=step,ep=high[0],sar=low[0];for(let i=1;i<n;i++){sar=sar+af*(ep-sar);if(bull){sar=Math.min(sar,low[i-1],i>1?low[i-2]:low[i-1]);if(low[i]<sar){bull=false;sar=ep;ep=low[i];af=step}else if(high[i]>ep){ep=high[i];af=Math.min(max,af+step)}}else{sar=Math.max(sar,high[i-1],i>1?high[i-2]:high[i-1]);if(high[i]>sar){bull=true;sar=ep;ep=high[i];af=step}else if(low[i]<ep){ep=low[i];af=Math.min(max,af+step)}}out[i]=sar}return out}
export const BUILT_INS={
  EMA:{id:'ema',name:'Exponential Moving Average',overlay:true,defaults:{period:20},compute:(d,p)=>[{name:`EMA ${p.period}`,values:ema(d.close,p.period)}]},
  SMA:{id:'sma',name:'Simple Moving Average',overlay:true,defaults:{period:20},compute:(d,p)=>[{name:`SMA ${p.period}`,values:sma(d.close,p.period)}]},
  WMA:{id:'wma',name:'Weighted Moving Average',overlay:true,defaults:{period:20},compute:(d,p)=>[{name:`WMA ${p.period}`,values:wma(d.close,p.period)}]},
  DEMA:{id:'dema',name:'Double EMA',overlay:true,defaults:{period:20},compute:(d,p)=>[{name:`DEMA ${p.period}`,values:dema(d.close,p.period)}]},
  TEMA:{id:'tema',name:'Triple EMA',overlay:true,defaults:{period:20},compute:(d,p)=>[{name:`TEMA ${p.period}`,values:tema(d.close,p.period)}]},
  BOLL:{id:'bollinger',name:'Bollinger Bands',overlay:true,defaults:{period:20,mult:2},compute:(d,p)=>{const b=bollinger(d.close,p.period,p.mult);return[{name:'BB Upper',values:b.upper},{name:'BB Basis',values:b.mid},{name:'BB Lower',values:b.lower}]}},
  VWAP:{id:'vwap',name:'VWAP',overlay:true,defaults:{},compute:d=>[{name:'VWAP',values:vwap(d.high,d.low,d.close,d.volume)}]},
  DONCH:{id:'donchian',name:'Donchian Channels',overlay:true,defaults:{period:20},compute:(d,p)=>{const x=donchian(d.high,d.low,p.period);return[{name:'DC Upper',values:x.upper},{name:'DC Mid',values:x.mid},{name:'DC Lower',values:x.lower}]}},
  KELT:{id:'keltner',name:'Keltner Channels',overlay:true,defaults:{period:20,mult:2},compute:(d,p)=>{const x=keltner(d.high,d.low,d.close,p.period,p.mult);return[{name:'KC Upper',values:x.upper},{name:'KC Mid',values:x.mid},{name:'KC Lower',values:x.lower}]}},
  SUPERT:{id:'supertrend',name:'Supertrend',overlay:true,defaults:{period:10,mult:3},compute:(d,p)=>[{name:'Supertrend',values:supertrend(d.high,d.low,d.close,p.period,p.mult)}]},
  ICHI:{id:'ichimoku',name:'Ichimoku Cloud',overlay:true,defaults:{tenkan:9,kijun:26,senkou:52},compute:(d,p)=>{const x=ichimoku(d.high,d.low,p.tenkan,p.kijun,p.senkou);return[{name:'Tenkan',values:x.tenkan},{name:'Kijun',values:x.kijun},{name:'Span A',values:x.spanA},{name:'Span B',values:x.spanB}]}},
  PSAR:{id:'psar',name:'Parabolic SAR',overlay:true,defaults:{step:.02,max:.2},compute:(d,p)=>[{name:'PSAR',values:psar(d.high,d.low,p.step,p.max)}]},
  RSI:{id:'rsi',name:'Relative Strength Index',overlay:false,scale:{min:0,max:100,levels:[30,50,70]},defaults:{period:14},compute:(d,p)=>[{name:`RSI ${p.period}`,values:rsi(d.close,p.period)}]},
  MACD:{id:'macd',name:'MACD',overlay:false,defaults:{fast:12,slow:26,signal:9},compute:(d,p)=>{const m=macd(d.close,p.fast,p.slow,p.signal);return[{name:'MACD',values:m.macd},{name:'Signal',values:m.signal},{name:'Histogram',values:m.hist,type:'histogram'}]}},
  ATR:{id:'atr',name:'Average True Range',overlay:false,defaults:{period:14},compute:(d,p)=>[{name:`ATR ${p.period}`,values:atr(d.high,d.low,d.close,p.period)}]},
  STOCH:{id:'stoch',name:'Stochastic',overlay:false,scale:{min:0,max:100,levels:[20,50,80]},defaults:{k:14,d:3},compute:(d,p)=>{const x=stochastic(d.high,d.low,d.close,p.k,p.d);return[{name:'%K',values:x.k},{name:'%D',values:x.d}]}},
  ADX:{id:'adx',name:'Average Directional Index',overlay:false,scale:{min:0,max:100,levels:[20,25,50]},defaults:{period:14},compute:(d,p)=>{const x=adx(d.high,d.low,d.close,p.period);return[{name:'ADX',values:x.adx},{name:'+DI',values:x.plus},{name:'-DI',values:x.minus}]}},
  CCI:{id:'cci',name:'Commodity Channel Index',overlay:false,scale:{min:-250,max:250,levels:[-100,0,100]},defaults:{period:20},compute:(d,p)=>[{name:'CCI',values:cci(d.high,d.low,d.close,p.period)}]},
  MFI:{id:'mfi',name:'Money Flow Index',overlay:false,scale:{min:0,max:100,levels:[20,50,80]},defaults:{period:14},compute:(d,p)=>[{name:'MFI',values:mfi(d.high,d.low,d.close,d.volume,p.period)}]},
  WILLR:{id:'williamsr',name:'Williams %R',overlay:false,scale:{min:-100,max:0,levels:[-80,-50,-20]},defaults:{period:14},compute:(d,p)=>[{name:'Williams %R',values:williamsR(d.high,d.low,d.close,p.period)}]},
  ROC:{id:'roc',name:'Rate of Change',overlay:false,defaults:{period:12},compute:(d,p)=>[{name:'ROC',values:roc(d.close,p.period)}]},
  MOM:{id:'momentum',name:'Momentum',overlay:false,defaults:{period:10},compute:(d,p)=>[{name:'Momentum',values:momentum(d.close,p.period)}]},
  OBV:{id:'obv',name:'On Balance Volume',overlay:false,defaults:{},compute:d=>[{name:'OBV',values:obv(d.close,d.volume)}]},
  CMO:{id:'cmo',name:'Chande Momentum Oscillator',overlay:false,scale:{min:-100,max:100,levels:[-50,0,50]},defaults:{period:14},compute:(d,p)=>[{name:'CMO',values:cmo(d.close,p.period)}]}
};
